# ============================================================
# .env.example — Copy to .env and fill in your credentials
# Never commit the actual .env file to Git
# ============================================================

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_pipeline
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- Alpha Vantage API (free at https://www.alphavantage.co/support/#api-key) ---
ALPHA_VANTAGE_KEY=your_api_key_here

# --- Email Alerts (optional — uses Gmail SMTP or any SMTP provider) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_FROM_EMAIL=your.email@gmail.com
ALERT_TO_EMAIL=recipient@example.com

# --- Power BI REST API (optional — enables auto dashboard refresh) ---
# Get from Azure App Registration: https://app.powerbi.com
POWERBI_CLIENT_ID=your_azure_app_client_id
POWERBI_CLIENT_SECRET=your_azure_app_client_secret
POWERBI_TENANT_ID=your_azure_tenant_id
POWERBI_WORKSPACE_ID=your_power_bi_workspace_id
POWERBI_DATASET_ID=your_power_bi_dataset_id

# --- Tableau (alternative to Power BI — optional) ---
TABLEAU_SERVER_URL=https://your-tableau-server.com
TABLEAU_SITE_ID=your_site_id
TABLEAU_TOKEN_NAME=your_personal_access_token_name
TABLEAU_TOKEN_SECRET=your_personal_access_token_secret
TABLEAU_DATASOURCE_ID=your_datasource_id
